SubDir bigevilcorp tanglewood ;
 
if ( ( win32 in $(PLATFORM) ) | ( win64 in $(PLATFORM) ) )
{
	ion_renderer_opts = shader ;
}
else
{
	ion_renderer_opts = fixed ;
}

ApplyIonCompiler tanglewood ;
ApplyIonDefines tanglewood ;
ApplyIonIncludes tanglewood ;
ApplyIonCore tanglewood ;
ApplyIonRenderer tanglewood ;
ApplyIonInput tanglewood ;
ApplyIonGameKit tanglewood ;
ApplyIonGui tanglewood ;
ApplyIonLib tanglewood : beehive ;

C.IncludeDirectories tanglewood : $(bigevilcorp)/tanglewood ;

SubInclude bigevilcorp ion renderer imageformats : imageformats ;
C.IncludeDirectories tanglewood : $(bigevilcorp)/ion/renderer/imageformats ;
C.LinkLibraries tanglewood : imageformats ;

local SRC =
	main.cpp

	Animations.h
	Constants.h
	Debug.cpp
	Debug.h
	Globals.cpp
	Globals.h
	LevelSystem.cpp
	LevelSystem.h
	ObjectRegistry.cpp
	Palettes.cpp
	Palettes.h
	Tanglewood.cpp
	Tanglewood.h

	cutscenes/Common.h
	cutscenes/DjakkReveal.h

	effects/Fader.cpp
	effects/Fader.h
	effects/Letterbox.cpp
	effects/Letterbox.h

	framework/Barrier.h
	framework/Camera.cpp
	framework/Camera.h
	framework/Character.cpp
	framework/Character.h
	framework/Cutscene.cpp
	framework/Cutscene.h
	framework/Entity.cpp
	framework/Entity.h
	framework/Level.cpp
	framework/Level.h
	framework/ObjectFactory.cpp
	framework/ObjectFactory.h
	framework/PaletteTools.cpp
	framework/PaletteTools.h
	framework/Platform.h
	framework/Physics.cpp
	framework/Physics.h
	framework/PhysicsObj.cpp
	framework/PhysicsObj.h
	framework/Plane.cpp
	framework/Plane.h
	framework/Sprite.cpp
	framework/Sprite.h
	framework/SpriteObj.cpp
	framework/SpriteObj.h
	framework/State.cpp
	framework/State.h
	framework/Types.h
	framework/World.cpp
	framework/World.h

	tanglewood/Boulder.cpp
	tanglewood/Boulder.h
	tanglewood/Checkpoint.cpp
	tanglewood/Checkpoint.h
	tanglewood/DeathBox.cpp
	tanglewood/DeathBox.h
	tanglewood/Djakk.cpp
	tanglewood/Djakk.h
	tanglewood/Enemy.cpp
	tanglewood/Enemy.h
	tanglewood/Firefly.cpp
	tanglewood/Firefly.h
	tanglewood/Flue.cpp
	tanglewood/Flue.h
	tanglewood/Fuzzl.cpp
	tanglewood/Fuzzl.h
	tanglewood/Hogg.cpp
	tanglewood/Hogg.h
	tanglewood/Mushroom.cpp
	tanglewood/Mushroom.h
	tanglewood/Nest.cpp
	tanglewood/Nest.h
	tanglewood/Player.cpp
	tanglewood/Player.h
	tanglewood/PlayerController.cpp
	tanglewood/PlayerController.h
	tanglewood/Scirus.cpp
	tanglewood/Scirus.h
	tanglewood/Stone.cpp
	tanglewood/Stone.h
	tanglewood/TriggerBox.cpp
	tanglewood/TriggerBox.h

	states/StateEndAct.cpp
	states/StateEndAct.h
	states/StateEndChapter.cpp
	states/StateEndChapter.h
	states/StateFail.cpp
	states/StateFail.h
	states/StateLoading.cpp
	states/StateLoading.h
	states/StateGameplay.cpp
	states/StateGameplay.h

	levels/LevelList.h
	levels/L1A1.cpp
	levels/L1A1.h
	levels/L1A2.cpp
	levels/L1A2.h
	levels/L1A3.cpp
	levels/L1A3.h
	levels/L1A4.cpp
	levels/L1A4.h
	;

if ( shader in $(ion_renderer_opts) )
{
	SRC +=
		Shaders.cpp
		Shaders.h
	;
}

AutoSourceGroup tanglewood : $(SRC) ;
C.RuntimeType tanglewood : static ;
C.Application tanglewood : $(SRC) ;
