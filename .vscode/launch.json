    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Attach Redream (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tanglewood/_Build/dreamcast/_intermediates_/dreamcast-debug/bigevilcorp/tanglewood/tanglewood/tanglewood.elf",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerServerAddress": "localhost:24690",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }],
            "windows": {
                "miDebuggerPath": "C:/msys32/opt/toolchains/dc/sh-elf/bin/sh-elf-gdb.exe",
            }
        },
